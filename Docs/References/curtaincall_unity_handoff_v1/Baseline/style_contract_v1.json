  "component_layer_plans": [
    {
      "id": "C2",
      "back_to_front": "숫자 받침 → 시계 아이콘 → 시간 TMP → 경고 강조",
      "rule": "C2는 마지막 30초 황색, 마지막 10초 붉은 강조. 경고 상태의 크기는 동일",
      "status": "planned_not_generated"
    },
    {
      "id": "C3",
      "back_to_front": "받침 → 트랙 → 눈금 → 최대 도달/추락/도착 마커 → 동료 → 불 → 내 마커 → TMP → 경고선",
      "rule": "눈금·각 마커는 별도 위치. 불 접근 시 트랙/경고선 빨강",
      "status": "planned_not_generated"
    },
    {
      "id": "P1",
      "back_to_front": "받침 → 좌 위험/안전/우 위험 구간 → 경계·빗금 → 바늘 → 체류 트랙/채움 → 키캡 → TMP",
      "rule": "안전 구간 폭·바늘·체류 채움 독립. 튜닝 비율은 게임 데이터",
      "status": "planned_not_generated"
    },
    {
      "id": "W1",
      "back_to_front": "숫자 받침 → 빈 링 → 흰 채움 링 → 벽시계 눈금 → 베젤 → 시간 TMP → 경보 링",
      "rule": "평소 크림·멈춤 회색·소집 경보 빨강. 지붕과 깃발 없음",
      "status": "planned_not_generated"
    },
    {
      "id": "C4",
      "back_to_front": "작은 받침 → 화폐 아이콘 → 금액 TMP → 변화 강조",
      "rule": "대기실에서만. C12 동전 연출과 아이콘 재사용",
      "status": "planned_not_generated"
    },
    {
      "id": "C5",
      "back_to_front": "슬롯 바탕 → 기본 테두리 → 기물 아이콘 → 선택 테두리 → 키/수량 TMP",
      "rule": "한 칸 단위. 빈 상태는 아이콘 숨김, 칸 수 미정",
      "status": "planned_not_generated"
    },
    {
      "id": "W6",
      "back_to_front": "작은 받침 → 인원 아이콘 → 현재/목표 TMP",
      "rule": "집결 통로에 있을 때만",
      "status": "planned_not_generated"
    },
    {
      "id": "L1",
      "back_to_front": "받침 → 눈 버튼 → 눈 열림/닫힘·복사 아이콘 → 코드·방장·인원 TMP",
      "rule": "가린 코드는 TMP 점 반복. 실제 코드를 이미지에 넣지 않음",
      "status": "planned_not_generated"
    },
    {
      "id": "C8 배너",
      "back_to_front": "9-slice 띠 → 일반/위험 강조선 → 선택 아이콘 → 제목/부제 TMP",
      "rule": "제목·부제 영역과 테두리 독립",
      "status": "planned_not_generated"
    },
    {

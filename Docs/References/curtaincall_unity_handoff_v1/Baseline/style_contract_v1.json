  "state_visual_rules": {
    "normal": "base material and subdued metal border",
    "hover": "surface.hover, brighter edge.metal, 80ms",
    "pressed": "surface.pressed, inner edge darkening; text/icon child offset y=-1ui, 50ms",
    "disabled": "semantic.disabled on border, text.disabled at alpha1; stop hover/pressed; do not fade the whole hierarchy",
    "selected": "independent 2ui underline or selection edge, retained with hover/pressed/disabled",
    "focus": "independent 2ui outer marker; material tint lowered when disabled"
  },

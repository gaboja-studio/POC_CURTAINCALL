  m_Script: {fileID: 11500000, guid: d731a896f5ffd8a42a1922e6e575ae26, type: 3}
  m_Name: WaitingRoomHud
  m_EditorClassIdentifier: Assembly-CSharp::CurtainCall.WaitingRoom.WaitingRoomHudProfile
  rest: 0000000001000000
  night: 00000000010000000200000003000000
  restExtra: []
  nightExtra: []
  tutorials:
  - id: G01
    role: 0
    title: "\uB300\uAE30\uC2E4"
    body: "\uACF5\uC5F0\uC744 \uC900\uBE44\uD558\uACE0, \uC0C1\uC810\uACFC \uC11C\uBE44\uC2A4\uB97C
      \uC774\uC6A9\uD558\uB294 \uACF5\uAC04"
    seconds: 0
  - id: G02
    role: 0
    title: "\uC900\uBE44 \uC2DC\uAC04"
    body: "\uC815\uD574\uC9C4 \uACF5\uC5F0 \uC900\uBE44 \uC2DC\uAC04\uB3D9\uC548
      \uD0D0\uC0C9\uC774 \uAC00\uB2A5\uD558\uBA70 \n\uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74
      \uAC10\uC2DC\uC790\uB4E4\uC758 \uCD94\uACA9\uC774 \uC2DC\uC791\uB429\uB2C8\uB2E4."
    seconds: 0
  - id: G03
    role: 0
    title: "\uC0C1\uD638\uC791\uC6A9"
    body: 
    seconds: 0
  - id: G04
    role: 0
    title: 
    body: 
    seconds: 0
  - id: G05
    role: 0
    title: 
    body: 
    seconds: 0
  - id: G06a
    role: 0
    title: 
    body: "\uC7A0\uAE34 \uC0C1\uC790\xB7\uCE90\uBE44\uB137 \uC55E\uC5D0\uC11C [{interact}]\uB97C
      \uB20C\uB7EC \uC5F4\uAE30\uB97C \uC2DC\uB3C4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    seconds: 0
  - id: G06b
    role: 0
    title: 
    body: "\uB098\uBB34 \uC0C1\uC790\uB098 \uB179\uC2A8 \uBCBD\uC5D0\uC11C [{interact}]\uB97C
      \uB20C\uB7EC \uBD80\uC220 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    seconds: 0
  - id: G06c
    role: 0
    title: 
    body: 
    seconds: 0
  - id: G07
    role: 0
    title: 
    body: 
    seconds: 0
  - id: G08
    role: 0
    title: 
    body: 
    seconds: 0
  - id: G09
    role: 0
    title: 
    body: "\uC0C1\uC810\uC5D0\uC11C \uAE30\uBB3C\xB7\uC11C\uBE44\uC2A4\uB97C \uAD6C\uB9E4\uD558\uAC70\uB098
      \uC774\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    seconds: 0
  - id: G10
    role: 0
    title: 
    body: 
    seconds: 0
  - id: G11
    role: 0
    title: "\uBB34\uB300 \uBCF5\uADC0"
    body: "\uBAA8\uB4E0 \uB2E8\uC6D0\uC774 \uACF5\uC5F0 \uBB34\uB300 \uC785\uAD6C\uB85C
      \uB4E4\uC5B4\uC11C\uBA74 \uB2E4\uC74C \uACF5\uC5F0\uC744 \uC9C4\uD589\uD569\uB2C8\uB2E4."
    seconds: 0
  - id: G11A
    role: 3
    title: 
    body: "\uC81C\uD55C \uC2DC\uAC04 \uC548\uC5D0 \uBB34\uB300 \uACF5\uC5F0 \uC785\uAD6C\uC5D0
      \uBAA8\uC774\uC138\uC694."
    seconds: 0
  - id: G12
    role: 0
    title: 
    body: 
    seconds: 0
  - id: N01
    role: 0
    title: "\uC815\uBE44 \uC2DC\uAC04"
    body: "\uD558\uB8E8\uC758 \uACF5\uC5F0\uC744 \uB9C8\uBB34\uB9AC \uD558\uACE0
      \uB2E4\uC74C \uB0A0\uC744 \uC704\uD55C \uC815\uBE44\uB97C \uCDE8\uD569\uB2C8\uB2E4."
    seconds: 0
  - id: N02
    role: 0
    title: 
    body: "\uD1A0\uD070\uC744 \uC18C\uBAA8\uD574 \uC804\uD654\uAE30\uB85C \uAE30\uBB3C\uACFC
      \uC11C\uBE44\uC2A4\uB97C \uAD6C\uB9E4\uD560 \uC218 \uC788\uC73C\uBA70 \uC544\uB798
      \uBC30\uC1A1\uAD6C\uB97C \uD1B5\uD574 \uBC30\uCD9C\uB429\uB2C8\uB2E4."
    seconds: 0
  - id: N03
    role: 0
    title: 
    body: "\uBC29\uC7A5\uC740 \uC2A4\uCF00\uC904\uD45C\uC5D0\uC11C \uB2E4\uC74C \uC77C\uC815\uC744
      \uC218\uC815\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    seconds: 0
  - id: N04
    role: 0
    title: 
    body: "\uC120\uBC18\uC5D0 \uAE30\uBB3C\uC744 \uBCF4\uAD00\uD569\uB2C8\uB2E4.\n\uBCF4\uAD00\uB41C
      \uAE30\uBB3C\uC740 \uAC8C\uC784 \uC885\uB8CC \uC804\uAE4C\uC9C0 \uC720\uC9C0\uB429\uB2C8\uB2E4."
    seconds: 0
  - id: N05
    role: 0
    title: 
    body: "\uC900\uBE44\uAC00 \uB05D\uB098\uBA74 \uBAA8\uB4E0 \uB2E8\uC6D0\uC740
      \uCE68\uB300\uC5D0\uC11C [{interact}]\uB97C \uB20C\uB7EC \uC218\uBA74\uC744
      \uCDE8\uD569\uB2C8\uB2E4.\n\uBAA8\uB4E0 \uB2E8\uC6D0\uC774 \uC7A0\uB4E4\uBA74
      \uB2E4\uC74C \uB0A0\uC774 \uB429\uB2C8\uB2E4."
    seconds: 0
  - id: S01
    role: 0
    title: 
    body: "\uACF5\uC5F0\uC5D0\uC11C \uC785\uC740 \uBD80\uC0C1\uC740 \uBCF5\uADC0
      \uC2DC\uC5D0\uB3C4 \uC720\uC9C0\uB429\uB2C8\uB2E4.\n\uBD80\uC0C1\uC740 \uC11C\uBE44\uC2A4\uB97C
      \uD1B5\uD574 \uD68C\uBCF5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    seconds: 0
  - id: S02
    role: 0
    title: 
    body: "\uACF5\uC5F0\uC5D0\uC11C \uBCF5\uADC0\uD55C \uB4A4\uC5D0\uB3C4 \uB3D9\uB8CC\uC758
      \uBD80\uC0C1\uC740 \uC720\uC9C0\uB429\uB2C8\uB2E4."
    seconds: 0
  - id: S03
    role: 0
    title: 
    body: "\uB354 \uC774\uC0C1 \uAE30\uBB3C\uC744 \uC18C\uC9C0\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n[{interact}]\uB97C
      \uAE38\uAC8C \uB20C\uB7EC \uAE30\uBB3C\uC744 \uBC84\uB9AC\uAC70\uB098 \uC18C\uD488\uC2E4\uC5D0
      \uBCF4\uAD00\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    seconds: 0
  - id: S04
    role: 0
    title: 
    body: 
    seconds: 0

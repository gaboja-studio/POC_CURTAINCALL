    text: "\uB3D9\uB8CC \uAE30\uB2E4\uB9AC\uB294 \uC911"
  rehearsalCopy:
  - id: rehearsal.intro-title
    text: "\uC678\uC904 \uD0C0\uAE30 \uB9AC\uD5C8\uC124"
  - id: rehearsal.intro
    text: "\uC548\uB0B4\uC5D0 \uB530\uB77C \uB9AC\uD5C8\uC124\uC744 \uC9C4\uD589\uD569\uB2C8\uB2E4.\n(\uCD94\uB77D
      \uC2DC \uCD9C\uBC1C\uC810\uC5D0\uC11C \uB2E4\uC2DC \uC2DC\uC791)"
  - id: rehearsal.practice-title
    text: "\uC678\uC904 \uD0C0\uAE30 \uC5F0\uC2B5"
  - id: rehearsal.practice-intro
    text: "\uC790\uC720\uB86D\uAC8C \uC6D0\uD558\uB294 \uAD6C\uAC04\uBD80\uD130 \uC678\uC904\uD0C0\uAE30\uB97C \uC5F0\uC2B5\uD569\uB2C8\uB2E4.\n(\uCD94\uB77D \uC2DC \uCD9C\uBC1C\uC810\uC5D0\uC11C \uB2E4\uC2DC \uC2DC\uC791)"
  - id: rehearsal.practice-intro-no-recovery
    text: "\uC790\uC720\uB86D\uAC8C \uC6D0\uD558\uB294 \uAD6C\uAC04\uBD80\uD130 \uC678\uC904\uD0C0\uAE30\uB97C
      \uC5F0\uC2B5\uD569\uB2C8\uB2E4."
  - id: rehearsal.stage.1.guide-title
    text: "\uC678\uC904 \uC774\uB3D9"
  - id: rehearsal.stage.1.intro
    text: "\uC904 \uC704\uC5D0\uC11C\uB294 [{balance}]\uB97C \uB20C\uB7EC \uADE0\uD615\uC744 \uC720\uC9C0\uD569\uB2C8\uB2E4.\n[{forward}]\uB97C \uB20C\uB7EC \uC55E\uB4A4\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4."
  - id: rehearsal.stage.1.goal
    text: "\uB04A\uAE34 \uC904\uC744 \uAC74\uB108 \uB3C4\uCC29 \uC9C0\uC810\uAE4C\uC9C0
      \uC774\uB3D9.\n\uBAA8\uB4E0 \uB2E8\uC6D0\uC774 \uB3C4\uCC29\uD574\uC57C \uC131\uACF5"
  - id: rehearsal.stage.2-1.intro
    text: "\uADF8\uB124 \uC55E\uC5D0\uC11C [{interact}]\uB97C \uB20C\uB7EC \uADF8\uB124\uB97C
      \uC7A1\uC2B5\uB2C8\uB2E4.\n[{forward}]\uB85C \uBC18\uB3D9\uC744 \uC8FC\uACE0
      [{jump}]\uB97C \uB20C\uB7EC \uC810\uD504\uD569\uB2C8\uB2E4."
  - id: rehearsal.stage.2-1.guide-title
    text: "\uADF8\uB124 \uD0D1\uC2B9"
  - id: rehearsal.stage.2-1.title
    text: "2 \xB7 \uADF8\uB124\uD0C0\uACE0 \uAC74\uB108\uAE30"
  - id: rehearsal.stage.2-2.intro
    text: "\uADF8\uB124\uC5D0 \uB9E4\uB2EC\uB9B0 \uCC44 [{forward}]\uB85C \uBC18\uB3D9\uC744 \uC8FC\uACE0 [{jump}]\uB97C \uB20C\uB7EC \uC810\uD504\uD569\uB2C8\uB2E4.\n\uCCB4\uACF5 \uC911 \uB2E4\uC74C \uADF8\uB124 \uAC00\uAE4C\uC774\uC5D0\uC11C [{interact}]\uB97C \uB20C\uB7EC \uD0D1\uC2B9\uD569\uB2C8\uB2E4."
  - id: rehearsal.stage.2-2.title
    text: "3 \xB7 \uC5F0\uC18D\uC73C\uB85C \uADF8\uB124 \uD0C0\uAE30"
  - id: rehearsal.stage.2-3.intro
    text: "\uD2B8\uB9AC\uAC70 \uADF8\uB124\uB294 \uD0D1\uC2B9 \uC2DC \uB04A\uC5B4\uC9C4
      \uC904\uC744 \uC774\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC774\uC5B4\uC9C0\uB294
      \uC904\uC740 \uD0D1\uC2B9 \uC2DC\uB9C8\uB2E4 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4."
  - id: rehearsal.stage.2-3.title
    text: "4 \xB7 \uD2B8\uB9AC\uAC70 \uADF8\uB124"
  - id: rehearsal.stage.3.guide-title
    text: "\uB192\uC740 \uACF3\uC5D0 \uC704\uCE58\uD55C \uADF8\uB124 \uD0C0\uAE30"
  - id: rehearsal.stage.3.intro
    text: "\uB2E8\uC6D0 \uADFC\uCC98\uC5D0\uC11C [{interact}]\uB97C \uB20C\uB7EC
      \uBAA9\uB9C8\uB97C \uD0C0\uBA74 \uB354 \uB192\uC740 \uACF3\uC5D0 \uC788\uB294
      \uADF8\uB124\uB97C \uD0C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uADF8\uB124\uC5D0
      \uD0D1\uC2B9\uD55C \uB2E8\uC6D0 \uADFC\uCC98\uC5D0\uC11C\uB294 [{interact}]\uB97C
      \uB20C\uB7EC \uB2E4\uB9AC\uC5D0 \uB9E4\uB2EC\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: rehearsal.stage.3.title
    text: "5 \xB7 \uBAA9\uB9C8\uB85C \uB354 \uB192\uC740 \uADF8\uB124\uC5D0 \uD0D1\uC2B9\uD558\uAE30"
  - id: rehearsal.lane-guide
    text: "[{side}]\uB85C \uC591
      \uC606\uC5D0 \uC788\uB294 \uC904\uB85C \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: rehearsal.lane-guide-title
    text: "\uC606 \uC904\uB85C \uC774\uB3D9"
  - id: rehearsal.mount
    text: "\uB3D9\uB8CC \uAC00\uAE4C\uC774\uC5D0\uC11C [{interact}]\uB97C \uB20C\uB7EC
      \uBAA9\uB9C8\uB97C \uD0C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: rehearsal.complete
    text: "\uBC14\uB2E5\uC758 \uAE38\uC548\uB0B4\uB97C \uB530\uB77C \uBB34\uB300 \uC785\uAD6C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4.\n\uBAA8\uB4E0 \uB2E8\uC6D0\uC774 \uBAA8\uC774\uBA74 \uCCAB \uACF5\uC5F0\uC774 \uC2DC\uC791\uB429\uB2C8\uB2E4."
  - id: rehearsal.quest.pole-grab.title
    text: "\uADF8\uB124 \uD0C0\uAE30"
  - id: rehearsal.quest.pole-grab
    text: "\uADF8\uB124 \uADFC\uCC98\uC5D0\uC11C [{interact}]\uB97C \uB20C\uB7EC
      \uADF8\uB124\uC5D0 \uD0D1\uC2B9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: rehearsal.quest.pole-single.title
    text: "\uADF8\uB124\uC5D0\uC11C \uB3C4\uC57D\uD558\uAE30"
  - id: rehearsal.quest.pole-single
    text: "[{forward}]\uB85C \uBC18\uB3D9\uC744 \uBAA8\uC740 \uB4A4 [{jump}]\uB97C
      \uB20C\uB7EC \uB3C4\uC57D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n[{interact}]\uB97C
      \uAE38\uAC8C \uB204\uB974\uBA74 \uADF8\uB124\uC5D0\uC11C \uB0B4\uB824\uC635\uB2C8\uB2E4."
  - id: rehearsal.quest.pole-next
    text: "\uADF8\uB124\uC5D0 \uB9E4\uB2EC\uB9B0 \uCC44 [{forward}]\uB85C \uBC18\uB3D9\uC744 \uC8FC\uACE0 [{jump}]\uB97C \uB20C\uB7EC \uC810\uD504\uD569\uB2C8\uB2E4.\n\uCCB4\uACF5 \uC911 \uB2E4\uC74C \uADF8\uB124 \uAC00\uAE4C\uC774\uC5D0\uC11C [{interact}]\uB97C \uB20C\uB7EC \uD0D1\uC2B9\uD569\uB2C8\uB2E4."
  - id: rehearsal.quest.pole-next.title
    text: "\uB2E4\uB978 \uADF8\uB124\uB85C \uC774\uB3D9"
  - id: rehearsal.quest.trigger-hold
    text: "\uD2B8\uB9AC\uAC70 \uADF8\uB124\uB294 \uD0D1\uC2B9 \uC2DC \uB04A\uC5B4\uC9C4
      \uC904\uC744 \uC774\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC774\uC5B4\uC9C0\uB294
      \uC904\uC740 \uD0D1\uC2B9 \uC2DC\uB9C8\uB2E4 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4."
  - id: rehearsal.quest.trigger-hold.title
    text: "\uD2B8\uB9AC\uAC70 \uADF8\uB124"
  - id: rehearsal.quest.trigger-grab
    text: "\uD2B8\uB9AC\uAC70 \uADF8\uB124\uB294 \uD0D1\uC2B9 \uC2DC \uB04A\uC5B4\uC9C4
      \uC904\uC744 \uC774\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: rehearsal.quest.trigger-grab.title
    text: "\uD2B8\uB9AC\uAC70 \uADF8\uB124"
  - id: rehearsal.quest.trigger-open.title
    text: "\uC5F0\uACB0\uB41C \uC904 \uAC74\uB108\uAE30"
  - id: rehearsal.quest.trigger-closed.title
    text: "\uB04A\uC5B4\uC9C4 \uC904"
  - id: rehearsal.quest.hang-help
    text: "\uC904\uC5D0 \uB9E4\uB2EC\uB824 \uBC84\uD2F0\uB294 \uB3D9\uC548 \uB2E4\uB978
      \uB3D9\uB8CC\uC5D0\uAC8C \uB3C4\uC6C0 \uC694\uCCAD"
  - id: rehearsal.quest.hang-help.title
    text: "\uB9E4\uB2EC\uB9B0 \uCC44 \uB3C4\uC6C0 \uC694\uCCAD\uD558\uAE30"
  - id: rehearsal.quest.rescue-team
    text: "\uC904\uC5D0 \uB9E4\uB2EC\uB824 \uBC84\uD2F0\uB294 \uB3D9\uB8CC \uADFC\uCC98\uC5D0\uC11C
      [{interact}]\uB97C \uAE38\uAC8C \uB20C\uB7EC \uB04C\uC5B4\uC62C\uB9AC\uAE30"
  - id: rehearsal.quest.rescue-team.title
    text: "\uB9E4\uB2EC\uB9B0 \uB3D9\uB8CC \uAD6C\uD558\uAE30"
  - id: rehearsal.stage.1.title
    text: "1 \u00B7 \uC678\uC904 \uAC74\uB108\uAE30"
  - id: rehearsal.stage.2-1.goal
    text: "\uADF8\uB124\uB97C \uD0C0\uACE0 \uAC74\uB108\uD3B8 \uC904\uC5D0 \uCC29\uC9C0\uD558\uAE30\n\uB3C4\uCC29 \uC9C0\uC810\uAE4C\uC9C0 \uC774\uB3D9\uD558\uAE30"
  - id: rehearsal.stage.2-2.guide-title
    text: "\uC5F0\uC18D \uADF8\uB124"
  - id: rehearsal.stage.2-2.goal
    text: "\uADF8\uB124\uB97C \uC5F0\uC18D\uC73C\uB85C \uAC08\uC544\uD0C0\uAE30\n\uB9C8\uC9C0\uB9C9 \uC904\uC758 \uB3C4\uCC29 \uC9C0\uC810\uAE4C\uC9C0 \uC774\uB3D9\uD558\uAE30"
  - id: rehearsal.stage.2-3.guide-title
    text: "\uD2B8\uB9AC\uAC70 \uADF8\uB124"
  - id: rehearsal.stage.2-3.goal
    text: "\uD2B8\uB9AC\uAC70 \uADF8\uB124\uB85C \uB04A\uAE34 \uC904 \uC787\uAE30\n\uC774\uC5B4\uC9C4 \uC904\uC744 \uAC74\uB108 \uB3C4\uCC29 \uC9C0\uC810\uAE4C\uC9C0 \uC774\uB3D9\uD558\uAE30"
  - id: rehearsal.stage.3.goal
    text: "\uBAA9\uB9C8\uB85C \uB3D9\uB8CC\uC640 \uCCAB \uADF8\uB124\uC5D0 \uB9E4\uB2EC\uB9AC\uAE30\n\uB2E4\uC74C \uADF8\uB124\uAE4C\uC9C0 \uB3C4\uC57D\uD574 \uD0D1\uC2B9\uD558\uAE30"
  - id: rehearsal.mount-title
    text: "\uBAA9\uB9C8 \uD0C0\uAE30"
  - id: rehearsal.fall-title
    text: "\uCD94\uB77D"
  - id: rehearsal.fall
    text: "\uCD94\uB77D\uD558\uC5EC \uAD6C\uAC04 \uCD9C\uBC1C\uC810\uC5D0\uC11C \uB2E4\uC2DC \uC2DC\uC791\uD569\uB2C8\uB2E4."
  - id: rehearsal.complete-title
    text: "\uB9AC\uD5C8\uC124 \uC644\uB8CC"
  - id: rehearsal.quest.trigger-open
    text: "\uC5F0\uACB0\uB41C \uC904\uC744 \uB530\uB77C \uAC74\uB108\uD3B8\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4."
  - id: rehearsal.quest.trigger-closed
    text: "\uC55E\uC758 \uC904\uC774 \uB04A\uACA8 \uC788\uC2B5\uB2C8\uB2E4.\n\uB2E4\uB978 \uB2E8\uC6D0\uC774 \uD2B8\uB9AC\uAC70 \uADF8\uB124\uC5D0 \uD0D1\uC2B9\uD558\uBA74 \uC904\uC774 \uC774\uC5B4\uC9D1\uB2C8\uB2E4."
  - id: rehearsal.quest.rescue-pull.title
    text: "\uB3D9\uB8CC \uB04C\uC5B4\uC62C\uB9AC\uAE30"
  - id: rehearsal.quest.rescue-pull
    text: "\uAD6C\uC870\uAC00 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0 [{interact}] \uACC4\uC18D \uB204\uB974\uAE30"
  - id: rehearsal.quest.balance.title
    text: "\uADE0\uD615 \uC7A1\uAE30"
  - id: rehearsal.quest.balance
    text: "[{balance}]\uB85C \uADE0\uD615 \uC7A1\uAE30\n[{forward}]\uB85C \uC678\uC904 \uAC74\uB108\uAE30"
  - id: rehearsal.quest.wait-team.title
    text: "\uB3D9\uB8CC \uAE30\uB2E4\uB9AC\uAE30"
  - id: rehearsal.quest.wait-team
    text: "\uBAA8\uB4E0 \uB2E8\uC6D0\uC774 \uB3C4\uCC29\uD560 \uB54C\uAE4C\uC9C0 \uB300\uAE30\uD558\uAE30"
  - id: rehearsal.quest.fallen.title
    text: "\uCCB4\uD06C\uD3EC\uC778\uD2B8 \uBCF5\uADC0"
  - id: rehearsal.quest.fallen
    text: "\uB9C8\uC9C0\uB9C9 \uCCB4\uD06C\uD3EC\uC778\uD2B8\uB85C \uBCF5\uADC0 \uB300\uAE30"
  - id: rehearsal.quest.practice-fallen.title
    text: "\uC5F0\uC2B5 \uC911 \uC0AC\uB9DD"
  - id: rehearsal.quest.practice-fallen
    text: "\uD638\uC2A4\uD2B8\uC758 \uC5F0\uC2B5 \uC885\uB8CC \uAE30\uB2E4\uB9AC\uAE30"
  - id: rehearsal.quest.lane-jump.title
    text: "\uC606 \uC904 \uAC74\uB108\uAE30"
  - id: rehearsal.quest.lane-jump
    text: "[{side}]\uB85C \uC606 \uC904 \uAC74\uB108\uAE30"
  - id: rehearsal.quest.lane-platform.title
    text: "\uC911\uAC04 \uBC1C\uD310"
  - id: rehearsal.quest.lane-platform
    text: "\uBC1C\uD310 \uC704\uC5D0\uC11C\uB294 [{move}]\uB85C \uC790\uC720\uB86D\uAC8C \uC774\uB3D9\uD569\uB2C8\uB2E4.\n\uC606 \uC904\uC744 \uD5A5\uD574 [{jump}]\uB97C \uB20C\uB7EC \uC810\uD504\uD569\uB2C8\uB2E4."
  - id: rehearsal.quest.trapeze.title
    text: "\uACF5\uC911\uADF8\uB124"
  - id: rehearsal.quest.trapeze-lane.title
    text: "\uACF5\uC911\uADF8\uB124 \uC9C4\uC785"
  - id: rehearsal.quest.trapeze-lane
    text: "[{side}]\uB85C {lane}\uBC88 \uC904\uC758 \uACF5\uC911\uADF8\uB124 \uC9C4\uC785 \uC704\uCE58\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4."
  - id: rehearsal.quest.trapeze-mount.title
    text: "\uBAA9\uB9C8 \uD0C0\uAE30"
  - id: rehearsal.quest.trapeze-mount
    text: "\uCCAB \uADF8\uB124\uB294 \uBAA9\uB9C8\uB97C \uD0C0\uC57C \uD0D1\uC2B9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uB3D9\uB8CC \uAC00\uAE4C\uC774\uC5D0\uC11C [{interact}]\uB97C \uB20C\uB7EC \uBAA9\uB9C8\uB97C \uD0D1\uB2C8\uB2E4."
  - id: rehearsal.quest.trapeze-grab.title
    text: "\uCCAB \uADF8\uB124 \uD0D1\uC2B9"
  - id: rehearsal.quest.trapeze-grab
    text: "\uBAA9\uB9C8 \uC704 \uB2E8\uC6D0\uC774 [{interact}]\uB97C \uB20C\uB7EC \uCCAB \uADF8\uB124\uC5D0 \uD0D1\uC2B9\uD569\uB2C8\uB2E4.\n\uC544\uB798 \uB2E8\uC6D0\uC740 [{interact}]\uB97C \uB20C\uB7EC \uB2E4\uB9AC\uC5D0 \uB9E4\uB2EC\uB9BD\uB2C8\uB2E4."
  - id: rehearsal.quest.trapeze-attach.title
    text: "\uB3D9\uB8CC\uC5D0\uAC8C \uB9E4\uB2EC\uB9AC\uAE30"
  - id: rehearsal.quest.trapeze-attach
    text: "\uADF8\uB124\uC5D0 \uD0D1\uC2B9\uD55C \uB3D9\uB8CC \uAC00\uAE4C\uC774\uC5D0\uC11C [{interact}]\uB97C \uB20C\uB7EC \uB9E4\uB2EC\uB9BD\uB2C8\uB2E4.\n\uBC18\uB3D9\uC5D0 \uB9DE\uCDB0 [{jump}]\uB97C \uB20C\uB7EC \uB2E4\uC74C \uADF8\uB124\uB85C \uB3C4\uC57D\uD569\uB2C8\uB2E4."
  - id: rehearsal.quest.gather.title
    text: "\uBB34\uB300 \uC785\uAD6C \uC9D1\uACB0"
  - id: rehearsal.quest.gather
    text: "\uBC14\uB2E5\uC758 \uAE38\uC548\uB0B4\uB97C \uB530\uB77C \uBB34\uB300 \uC785\uAD6C\uB85C \uC774\uB3D9\uD558\uAE30\n\uBAA8\uB4E0 \uB2E8\uC6D0\uC774 \uBAA8\uC774\uBA74 \uACF5\uC5F0 \uC2DC\uC791 [{inside}/{alive}]"
  - id: rehearsal.quest.gathered.title
    text: "\uC9D1\uACB0 \uB300\uAE30"
  - id: rehearsal.quest.gathered
    text: "\uB2E4\uB978 \uB2E8\uC6D0 \uAE30\uB2E4\uB9AC\uAE30 [{inside}/{alive}]"
  - id: rehearsal.skip.title
    text: "\uAD6C\uAC04 \uB118\uAE30\uAE30"
  - id: rehearsal.skip.body
    text: "\uACFC\uBC18\uC218\uAC00 \uB3D9\uC758\uD558\uBA74 \uD604\uC7AC \uAD6C\uAC04\uC744 \uB118\uAE41\uB2C8\uB2E4.\n(\uB3D9\uC758 {votes}/{required})"
  - id: rehearsal.practice-vote.title
    text: "\uB9AC\uD5C8\uC124 \uC7AC\uC5F0\uC2B5"
  - id: rehearsal.practice-vote.body
    text: "\uBAA8\uB4E0 \uB2E8\uC6D0\uC774 \uB3D9\uC758\uD558\uBA74 \uC678\uC904 \uD0C0\uAE30 \uB9AC\uD5C8\uC124\uC744 \uB2E4\uC2DC \uC5F0\uC2B5\uD569\uB2C8\uB2E4.\n(\uB3D9\uC758 {votes}/{total})"
  - id: rehearsal.practice-vote.cancel-title
    text: "\uC7AC\uC5F0\uC2B5 \uCDE8\uC18C"
  - id: rehearsal.practice-vote.cancel
    text: "\uB3D9\uC758\uD558\uC9C0 \uC54A\uC740 \uB2E8\uC6D0\uC774 \uC788\uC5B4 \uC7AC\uC5F0\uC2B5\uC744 \uCDE8\uC18C\uD569\uB2C8\uB2E4."
  - id: rehearsal.skip-ending
    text: "\uB9AC\uD5C8\uC124\uC744 \uC885\uB8CC\uD569\uB2C8\uB2E4."
  - id: cannon-rehearsal.title
    text: "\uC778\uAC04\uB300\uD3EC \uB9AC\uD5C8\uC124"
  - id: cannon-rehearsal.intro
    text: "\uB300\uD3EC\uC640 \uD2B8\uB7A8\uD384\uB9B0\uC744 \uC774\uC6A9\uD574 \uCD5C\uC885 \uB3C4\uCC29 \uC9C0\uC810\uAE4C\uC9C0 \uC774\uB3D9\uD569\uB2C8\uB2E4.\n(\uC0AC\uB9DD \uC2DC \uB9C8\uC9C0\uB9C9 \uCCB4\uD06C\uD3EC\uC778\uD2B8\uC5D0\uC11C \uB2E4\uC2DC \uC2DC\uC791)"
  - id: cannon-rehearsal.intro-no-recovery
    text: "\uB300\uD3EC\uC640 \uD2B8\uB7A8\uD384\uB9B0\uC744 \uC774\uC6A9\uD574 \uCD5C\uC885 \uB3C4\uCC29 \uC9C0\uC810\uAE4C\uC9C0 \uC774\uB3D9\uD569\uB2C8\uB2E4.\n\uC0AC\uB9DD\uD55C \uB2E8\uC6D0\uB3C4 \uB118\uAE30\uAE30\u00B7\uD3EC\uAE30 \uD22C\uD45C\uC5D0 \uCC38\uC5EC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: cannon-rehearsal.guide.cannon.title
    text: "\uC778\uAC04\uB300\uD3EC \uBC1C\uC0AC"
  - id: cannon-rehearsal.guide.cannon.body
    text: "\uC778\uAC04\uB300\uD3EC \uC55E\uC5D0\uC11C [{interact}]\uB97C \uB20C\uB7EC \uD0D1\uC2B9\uD569\uB2C8\uB2E4.\n\uB2E4\uC2DC [{interact}]\uB97C \uB204\uB974\uBA74 \uB300\uD3EC\uAC00 \uBC1C\uC0AC\uB429\uB2C8\uB2E4."
  - id: cannon-rehearsal.guide.trampoline.title
    text: "\uD2B8\uB7A8\uD384\uB9B0 \uC7A1\uAE30"
  - id: cannon-rehearsal.guide.trampoline.body
    text: "\uD2B8\uB7A8\uD384\uB9B0 \uC55E\uC5D0\uC11C [{interact}]\uB97C \uB20C\uB7EC \uD2B8\uB7A8\uD384\uB9B0\uC744 \uC7A1\uC2B5\uB2C8\uB2E4.\n\uBC1C\uC0AC\uB41C \uB3D9\uB8CC\uB97C \uD2B8\uB7A8\uD384\uB9B0\uC73C\uB85C \uBC1B\uC544\uC90D\uB2C8\uB2E4."
  - id: cannon-rehearsal.guide.carry.title
    text: "\uD2B8\uB7A8\uD384\uB9B0 \uC6B4\uBC18"
  - id: cannon-rehearsal.guide.carry.body
    text: "\uD2B8\uB7A8\uD384\uB9B0\uC744 \uB4E0 \uCC44 \uC790\uC720\uB86D\uAC8C \uC774\uB3D9\uD569\uB2C8\uB2E4.\n[{interact}]\uB97C \uAE38\uAC8C \uB204\uB974\uBA74 \uD2B8\uB7A8\uD384\uB9B0\uC744 \uB0B4\uB824\uB193\uC2B5\uB2C8\uB2E4."
  - id: cannon-rehearsal.guide.catch.title
    text: "\uB3D9\uB8CC \uBC1B\uC544\uC8FC\uAE30"
  - id: cannon-rehearsal.guide.catch.body
    text: "\uB3D9\uB8CC\uAC00 \uB5A8\uC5B4\uC9C0\uB294 \uC9C0\uC810\uC73C\uB85C \uD2B8\uB7A8\uD384\uB9B0\uC744 \uC62E\uACA8 \uBC1B\uC544\uC90D\uB2C8\uB2E4.\n\uBC18\uB3D9\uC744 \uC774\uC6A9\uD574 \uB3D9\uB8CC\uB97C \uB2E4\uC74C \uC9C0\uC810\uAE4C\uC9C0 \uBCF4\uB0C5\uB2C8\uB2E4."
  - id: cannon-rehearsal.guide.transport.title
    text: "\uD2B8\uB7A8 \uD0D1\uC2B9"
  - id: cannon-rehearsal.guide.transport.body
    text: "\uD2B8\uB7A8\uC740 \uC790\uB3D9\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4.\n\uB450 \uBA85 \uC774\uC0C1 \uD0D1\uC2B9\uD558\uBA74 \uCD9C\uBC1C\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - id: cannon-rehearsal.guide.bounce.title
    text: "\uBC18\uB3D9 \uCC29\uC9C0"
  - id: cannon-rehearsal.guide.bounce.body
    text: "\uD2B8\uB7A8\uD384\uB9B0\uC758 \uBC18\uB3D9\uC744 \uBC1B\uC73C\uBA74 \uC548\uC804\uD558\uAC8C \uCC29\uC9C0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n[{move}]\uB85C \uBC29\uD5A5\uC744 \uC870\uC808\uD574 \uB3C4\uCC29 \uC9C0\uC810\uC5D0 \uCC29\uC9C0\uD569\uB2C8\uB2E4."
  - id: cannon-rehearsal.guide.safe.title
    text: "\uC548\uC804 \uC9C0\uC5ED"
  - id: cannon-rehearsal.guide.safe.body
    text: "\uC548\uC804 \uC9C0\uC5ED\uC5D0\uC11C\uB294 \uCD94\uB77D \uD53C\uD574 \uC5C6\uC774 \uCC29\uC9C0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uBAA8\uB4E0 \uB2E8\uC6D0\uC774 \uB3C4\uCC29 \uC9C0\uC810\uC5D0 \uB3C4\uCC29\uD574\uC57C \uD569\uB2C8\uB2E4."
  - id: cannon-rehearsal.fall-title
    text: "\uC0AC\uB9DD"
  - id: cannon-rehearsal.fall-recover
    text: "\uC7A0\uC2DC \uB4A4 \uB9C8\uC9C0\uB9C9 \uCCB4\uD06C\uD3EC\uC778\uD2B8\uC5D0\uC11C \uB2E4\uC2DC \uC2DC\uC791\uD569\uB2C8\uB2E4."
  - id: cannon-rehearsal.fall
    text: "\uC790\uB3D9\uC73C\uB85C \uBD80\uD65C\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\uB118\uAE30\uAE30\u00B7\uD3EC\uAE30 \uD22C\uD45C\uC5D0\uB294 \uCC38\uC5EC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: cannon-rehearsal.retry-title
    text: "\uC7AC\uC5F0\uC2B5"
  - id: cannon-rehearsal.retry-body
    text: "\uC5F0\uC2B5\uC2E4 \uAE30\uBB3C \uC55E\uC5D0\uC11C [{interact}]\uB97C \uB20C\uB7EC \uB2E4\uC2DC \uC5F0\uC2B5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: cannon-rehearsal.first-title
    text: "\uC778\uAC04\uB300\uD3EC \uD0D1\uC2B9"
  - id: cannon-rehearsal.first
    text: "[{interact}]\uB97C \uB20C\uB7EC \uC778\uAC04\uB300\uD3EC \uD0D1\uC2B9\n\uBC1C\uC0AC\uD574 \uAC74\uB108\uD3B8\uC73C\uB85C \uAC74\uB108\uAC00\uAE30"
  - id: cannon-rehearsal.quest-title
    text: "\uB2E4\uC74C \uC9C0\uC810 \uC774\uB3D9"
  - id: cannon-rehearsal.second
    text: "\uC778\uAC04\uB300\uD3EC\uB85C \uBC1C\uC0AC\uD574 \uD2B8\uB7A8\uD384\uB9B0\uC5D0 \uCC29\uC9C0\uD558\uAE30\n\uD55C \uBA85\uC740 \uD2B8\uB7A8\uD384\uB9B0\uC73C\uB85C \uB3D9\uB8CC \uBC1B\uC544\uC8FC\uAE30"
  - id: cannon-rehearsal.safe-title
    text: "\uC548\uC804 \uC9C0\uC5ED \uC774\uB3D9"
  - id: cannon-rehearsal.safe-body
    text: "\uD2B8\uB7A8\uD384\uB9B0\uC744 \uC774\uC6A9\uD574 \uC548\uC804 \uC9C0\uC5ED\uC73C\uB85C \uC774\uB3D9\uD558\uAE30"
  - id: cannon-rehearsal.completed-title
    text: "\uB9AC\uD5C8\uC124 \uC644\uB8CC"
  - id: cannon-rehearsal.complete
    text: "\uC778\uAC04\uB300\uD3EC \uB9AC\uD5C8\uC124\uC744 \uC644\uB8CC\uD588\uC2B5\uB2C8\uB2E4.\n\uC774\uC81C \uC778\uAC04\uB300\uD3EC \uACF5\uC5F0\uC744 \uC9C4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: cannon-rehearsal.unlocked-title
    text: "\uC0C8 \uACF5\uC5F0 \uD574\uAE08"
  - id: cannon-rehearsal.unlocked-body
    text: "\uC778\uAC04\uB300\uD3EC \uACF5\uC5F0\uC774 \uD574\uAE08\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC9C0\uAE08 \uB9AC\uD5C8\uC124\uB85C \uC774\uB3D9\uD560\uAE4C\uC694?"
  - id: cannon-rehearsal.reminder-title
    text: "\uC778\uAC04\uB300\uD3EC \uB9AC\uD5C8\uC124 \uBBF8\uC774\uC218"
  - id: cannon-rehearsal.reminder-body
    text: "\uC544\uC9C1 \uC778\uAC04\uB300\uD3EC \uB9AC\uD5C8\uC124\uC744 \uC774\uC218\uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uC9C0\uAE08 \uB9AC\uD5C8\uC124\uB85C \uC774\uB3D9\uD560\uAE4C\uC694?"
  - id: cannon-rehearsal.pursuit
    text: "\uCD94\uACA9\uC804 \uC911\uC5D0\uB294 \uB9AC\uD5C8\uC124\uC744 \uC9C4\uD589\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uB2E4\uC74C \uC26C\uB294 \uC2DC\uAC04\uC5D0 \uB2E4\uC2DC \uC548\uB0B4\uD569\uB2C8\uB2E4."
  - id: cannon-rehearsal.required-title
    text: "\uB9AC\uD5C8\uC124 \uD544\uC694"
  - id: cannon-rehearsal.required
    text: "\uC778\uAC04\uB300\uD3EC\uB97C \uCC98\uC74C \uD3B8\uC131\uD558\uB824\uBA74 \uB9AC\uD5C8\uC124\uC744 \uC774\uC218\uD574\uC57C \uD569\uB2C8\uB2E4.\n\uC9C0\uAE08 \uB9AC\uD5C8\uC124\uC744 \uC9C4\uD589\uD560\uAE4C\uC694?"
  - id: cannon-rehearsal.vote-title
    text: "\uB118\uAE30\uAE30 / \uD3EC\uAE30"
  - id: cannon-rehearsal.vote-body
    text: "\uACFC\uBC18\uC218\uAC00 \uB3D9\uC758\uD558\uBA74 \uB118\uAE30\uAE30\uB294 \uC774\uC218, \uD3EC\uAE30\uB294 \uBBF8\uC774\uC218\uB85C \uC885\uB8CC\uD569\uB2C8\uB2E4.\n\uB118\uAE30\uAE30 {skip}/{required} \u00B7 \uD3EC\uAE30 {abandon}/{required}"
  - id: cannon-rehearsal.unavailable
    text: "\uC5F0\uC2B5\uC2E4\uC744 \uC900\uBE44\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.\n\uC7A0\uC2DC \uB4A4 \uC2A4\uCF00\uC904\uD45C\uC5D0\uC11C \uB2E4\uC2DC \uC2DC\uB3C4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: cannon-rehearsal.end-title
    text: "\uB9AC\uD5C8\uC124 \uC885\uB8CC"
  - id: cannon-rehearsal.skipped
    text: "\uB9AC\uD5C8\uC124\uC744 \uB118\uACBC\uC2B5\uB2C8\uB2E4.\n\uC774\uC218\uB85C \uAE30\uB85D\uB418\uC5B4 \uC778\uAC04\uB300\uD3EC\uB97C \uD3B8\uC131\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: cannon-rehearsal.abandoned
    text: "\uB9AC\uD5C8\uC124\uC744 \uD3EC\uAE30\uD588\uC2B5\uB2C8\uB2E4.\n\uBBF8\uC774\uC218\uB85C \uAE30\uB85D\uB418\uBA70, \uB2E4\uC2DC \uC2DC\uC791\uD558\uBA74 \uCC98\uC74C\uBD80\uD130 \uC9C4\uD589\uD569\uB2C8\uB2E4."

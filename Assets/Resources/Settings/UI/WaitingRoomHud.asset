    text: "\uB3D9\uB8CC \uAE30\uB2E4\uB9AC\uB294 \uC911"
  rehearsalCopy:
  - id: rehearsal.intro-title
    text: "\uC678\uC904 \uD0C0\uAE30 \uB9AC\uD5C8\uC124"
  - id: rehearsal.intro
    text: "\uC548\uB0B4\uC5D0 \uB530\uB77C \uB9AC\uD5C8\uC124\uC744 \uC9C4\uD589\uD569\uB2C8\uB2E4.\n(\uCD94\uB77D
      \uC2DC \uCD9C\uBC1C\uC810\uC5D0\uC11C \uB2E4\uC2DC \uC2DC\uC791)"
  - id: rehearsal.practice-title
    text: "\uC678\uC904 \uD0C0\uAE30 \uC5F0\uC2B5"
  - id: rehearsal.practice-intro
    text: "\uC790\uC720\uB86D\uAC8C \uC6D0\uD558\uB294 \uAD6C\uAC04\uBD80\uD130 \uC678\uC904\uD0C0\uAE30\uB97C
      \uC5F0\uC2B5\uD569\uB2C8\uB2E4.\n(\uCD94\uB77D \uC2DC \uCD9C\uBC1C\uC9C0\uC5D0\uC11C
      \uB2E4\uC2DC \uC2DC\uC791)"
  - id: rehearsal.practice-intro-no-recovery
    text: "\uC790\uC720\uB86D\uAC8C \uC6D0\uD558\uB294 \uAD6C\uAC04\uBD80\uD130 \uC678\uC904\uD0C0\uAE30\uB97C
      \uC5F0\uC2B5\uD569\uB2C8\uB2E4."
  - id: rehearsal.stage.1.guide-title
    text: "\uC678\uC904 \uC774\uB3D9"
  - id: rehearsal.stage.1.intro
    text: "\uC904 \uC704\uC5D0\uC11C\uB294 [{balance}]\uB97C \uB20C\uB7EC \uADE0\uD615\uC744
      \uC720\uC9C0\uD558\uACE0, \n[{forward}]\uB97C \uB20C\uB7EC \uC55E\uB4A4\uB85C
      \uC774\uB3D9\uD569\uB2C8\uB2E4."
  - id: rehearsal.stage.1.goal
    text: "\uB04A\uAE34 \uC904\uC744 \uAC74\uB108 \uB3C4\uCC29 \uC9C0\uC810\uAE4C\uC9C0
      \uC774\uB3D9.\n\uBAA8\uB4E0 \uB2E8\uC6D0\uC774 \uB3C4\uCC29\uD574\uC57C \uC131\uACF5"
  - id: rehearsal.stage.2-1.intro
    text: "\uADF8\uB124 \uC55E\uC5D0\uC11C [{interact}]\uB97C \uB20C\uB7EC \uADF8\uB124\uB97C
      \uC7A1\uC2B5\uB2C8\uB2E4.\n[{forward}]\uB85C \uBC18\uB3D9\uC744 \uC8FC\uACE0
      [{jump}]\uB97C \uB20C\uB7EC \uC810\uD504\uD569\uB2C8\uB2E4."
  - id: rehearsal.stage.2-1.guide-title
    text: "\uADF8\uB124 \uD0D1\uC2B9"
  - id: rehearsal.stage.2-1.title
    text: "2 \xB7 \uADF8\uB124\uD0C0\uACE0 \uAC74\uB108\uAE30"
  - id: rehearsal.stage.2-2.intro
    text: "\uADF8\uB124\uC5D0 \uB9E4\uB2EC\uB9B0 \uCC44 [{forward}]\uB85C \uBC18\uB3D9\uC744
      \uC8FC\uACE0 [{jump}]\uB97C \uB20C\uB7EC \uC810\uD504\uD569\uB2C8\uB2E4.\n\uCC44\uACF5
      \uC911 \uB2E4\uC74C \uADF8\uB124 \uAC00\uAE4C\uC774\uC5D0\uC11C [{interact}]\uB97C
      \uB20C\uB7EC \uD0D1\uC2B9\uD569\uB2C8\uB2E4."
  - id: rehearsal.stage.2-2.title
    text: "3 \xB7 \uC5F0\uC18D\uC73C\uB85C \uADF8\uB124 \uD0C0\uAE30"
  - id: rehearsal.stage.2-3.intro
    text: "\uD2B8\uB9AC\uAC70 \uADF8\uB124\uB294 \uD0D1\uC2B9 \uC2DC \uB04A\uC5B4\uC9C4
      \uC904\uC744 \uC774\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC774\uC5B4\uC9C0\uB294
      \uC904\uC740 \uD0D1\uC2B9 \uC2DC\uB9C8\uB2E4 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4."
  - id: rehearsal.stage.2-3.title
    text: "4 \xB7 \uD2B8\uB9AC\uAC70 \uADF8\uB124"
  - id: rehearsal.stage.3.guide-title
    text: "\uB192\uC740 \uACF3\uC5D0 \uC704\uCE58\uD55C \uADF8\uB124 \uD0C0\uAE30"
  - id: rehearsal.stage.3.intro
    text: "\uB2E8\uC6D0 \uADFC\uCC98\uC5D0\uC11C [{interact}]\uB97C \uB20C\uB7EC
      \uBAA9\uB9C8\uB97C \uD0C0\uBA74 \uB354 \uB192\uC740 \uACF3\uC5D0 \uC788\uB294
      \uADF8\uB124\uB97C \uD0C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uADF8\uB124\uC5D0
      \uD0D1\uC2B9\uD55C \uB2E8\uC6D0 \uADFC\uCC98\uC5D0\uC11C\uB294 [{interact}]\uB97C
      \uB20C\uB7EC \uB2E4\uB9AC\uC5D0 \uB9E4\uB2EC\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: rehearsal.stage.3.title
    text: "5 \xB7 \uBAA9\uB9C8\uB85C \uB354 \uB192\uC740 \uADF8\uB124\uC5D0 \uD0D1\uC2B9\uD558\uAE30"
  - id: rehearsal.lane-guide
    text: "[{side}]\uB97C \uB204\uB978 \uCC44\uB85C [{jump}]\uB97C \uB20C\uB7EC \uC591
      \uC606\uC5D0 \uC788\uB294 \uC904\uB85C \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: rehearsal.lane-guide-title
    text: "\uC606 \uC904\uB85C \uC774\uB3D9 "
  - id: rehearsal.mount
    text: "\uB3D9\uB8CC \uAC00\uAE4C\uC774\uC5D0\uC11C [{interact}]\uB97C \uB20C\uB7EC
      \uBAA9\uB9C8\uB97C \uD0C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: rehearsal.complete
    text: "\uBC14\uB2E5\uC758 \uAE38\uC548\uB0B4\uB97C \uB530\uB77C \uBB34\uB300
      \uC785\uAD6C\uB85C \uC774\uB3D9\uD558\uC138\uC694.\n\uBAA8\uB4E0 \uB2E8\uC6D0\uC774
      \uBAA8\uC774\uBA74 \uCCAB \uACF5\uC5F0\uC774 \uC2DC\uC791\uD569\uB2C8\uB2E4."
  - id: rehearsal.quest.pole-grab.title
    text: "\uADF8\uB124 \uD0C0\uAE30"
  - id: rehearsal.quest.pole-grab
    text: "\uADF8\uB124 \uADFC\uCC98\uC5D0\uC11C [{interact}]\uB97C \uB20C\uB7EC
      \uADF8\uB124\uC5D0 \uD0D1\uC2B9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: rehearsal.quest.pole-single.title
    text: "\uADF8\uB124\uC5D0\uC11C \uB3C4\uC57D\uD558\uAE30"
  - id: rehearsal.quest.pole-single
    text: "[{forward}]\uB85C \uBC18\uB3D9\uC744 \uBAA8\uC740 \uB4A4 [{jump}]\uB97C
      \uB20C\uB7EC \uB3C4\uC57D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n[{interact}]\uB97C
      \uAE38\uAC8C \uB204\uB974\uBA74 \uADF8\uB124\uC5D0\uC11C \uB0B4\uB824\uC635\uB2C8\uB2E4."
  - id: rehearsal.quest.pole-next
    text: "\uADF8\uB124\uC5D0 \uB9E4\uB2EC\uB9B0 \uCC44 [{forward}]\uB85C \uBC18\uB3D9\uC744
      \uC8FC\uACE0 [{jump}]\uB97C \uB20C\uB7EC \uC810\uD504\uD569\uB2C8\uB2E4.\n\uCC44\uACF5
      \uC911 \uB2E4\uC74C \uADF8\uB124 \uAC00\uAE4C\uC774\uC5D0\uC11C [{interact}]\uB97C
      \uB20C\uB7EC \uD0D1\uC2B9\uD569\uB2C8\uB2E4."
  - id: rehearsal.quest.pole-next.title
    text: "\uB2E4\uB978 \uADF8\uB124\uB85C \uC774\uB3D9"
  - id: rehearsal.quest.trigger-hold
    text: "\uD2B8\uB9AC\uAC70 \uADF8\uB124\uB294 \uD0D1\uC2B9 \uC2DC \uB04A\uC5B4\uC9C4
      \uC904\uC744 \uC774\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC774\uC5B4\uC9C0\uB294
      \uC904\uC740 \uD0D1\uC2B9 \uC2DC\uB9C8\uB2E4 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4."
  - id: rehearsal.quest.trigger-hold.title
    text: "\uD2B8\uB9AC\uAC70 \uADF8\uB124"
  - id: rehearsal.quest.trigger-grab
    text: "\uD2B8\uB9AC\uAC70 \uADF8\uB124\uB294 \uD0D1\uC2B9 \uC2DC \uB04A\uC5B4\uC9C4
      \uC904\uC744 \uC774\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: rehearsal.quest.trigger-grab.title
    text: "\uD2B8\uB9AC\uAC70 \uADF8\uB124"
  - id: rehearsal.quest.trigger-open.title
    text: "\uC5F0\uACB0\uB41C \uC904 \uAC74\uB108\uAE30"
  - id: rehearsal.quest.trigger-closed.title
    text: "\uB04A\uC5B4\uC9C4 \uC904"
  - id: rehearsal.quest.hang-help
    text: "\uC904\uC5D0 \uB9E4\uB2EC\uB824 \uBC84\uD2F0\uB294 \uB3D9\uC548 \uB2E4\uB978
      \uB3D9\uB8CC\uC5D0\uAC8C \uB3C4\uC6C0 \uC694\uCCAD"
  - id: rehearsal.quest.hang-help.title
    text: "\uB9E4\uB2EC\uB9B0 \uCC44 \uB3C4\uC6C0 \uC694\uCCAD\uD558\uAE30 "
  - id: rehearsal.quest.rescue-team
    text: "\uC904\uC5D0 \uB9E4\uB2EC\uB824 \uBC84\uD2F0\uB294 \uB3D9\uB8CC \uADFC\uCC98\uC5D0\uC11C
      [{interact}]\uB97C \uAE38\uAC8C \uB20C\uB7EC \uB04C\uC5B4\uC62C\uB9AC\uAE30"
  - id: rehearsal.quest.rescue-team.title
    text: "\uB9E4\uB2EC\uB9B0 \uB3D9\uB8CC \uAD6C\uD558\uAE30"

  balance:
    title: "\uADE0\uD615 \uC7A1\uAE30"
    body: "{balance}\uB85C \uADE0\uD615\uC744 \uC720\uC9C0"
    badge: '{move}'
  lane:
    title: "\uC606 \uC904 \uC774\uB3D9"
    body: "{side}\uB97C \uB204\uB978 \uCC44 {jump}\uB85C \uC810\uD504"
    badge: '{side}'
  sawGate:
    title: "\uD1B1\uB0A0 \uD68C\uD53C"
    body: "\uBAA9\uB9C8\uB97C \uC774\uC6A9\uD558\uAC70\uB098 \uC606\uC904\uB85C \uC774\uB3D9\uD574\n\uB2E4\uAC00\uC624\uB294

  approach:
    title: "\uC678\uC904 \uD0C0\uAE30"
    body: "\uC904 \uC704\uC5D0\uC11C {forward}\uB97C \uB20C\uB7EC \uC55E\uB4A4\uB85C
      \uC774\uB3D9"

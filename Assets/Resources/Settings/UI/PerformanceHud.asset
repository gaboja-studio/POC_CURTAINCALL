    body: "\uBAA9\uB9C8\uB97C \uC774\uC6A9\uD558\uAC70\uB098 \uC606\uC904\uB85C \uC774\uB3D9\uD574
      \uD1B1\uB0A0 \uB4A4\uC758 \uBC84\uD2BC\uC744 \uB204\uB974\uC138\uC694."

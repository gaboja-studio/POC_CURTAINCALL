  cannonGoal:
    title: "\uC778\uAC04 \uB300\uD3EC"
    body: "\uB300\uD3EC\uC640 \uD2B8\uB7A8\uD384\uB9B0\uC744 \uC0AC\uC6A9\uD558\uC5EC\n\uD2B8\uB799\uC758

  ropeGoal:
    title: "\uB3C4\uCC29 \uBC1C\uD310\uAE4C\uC9C0 \uAC74\uB108\uAE30"
    body: "\uC678\uC904\uC758 \uC7A5\uC560\uBB3C\uC744 \uC9C0\uB098 \uBC18\uB300\uD3B8
      \uB3C4\uCC29 \uBC1C\uD310\uC5D0 \uB3C4\uB2EC\uD558\uC138\uC694."
    badge: 
  cannonGoal:
    title: "\uBAA9\uC801\uC9C0\uC5D0 \uCC29\uC9C0\uD558\uAE30"
    body: "\uB300\uD3EC\uC640 \uD2B8\uB7A8\uD384\uB9B0\uC73C\uB85C \uCF54\uC2A4\uB97C
      \uAC74\uB108\uC138\uC694. \uC0B4\uC544 \uC788\uB294 \uB2E8\uC6D0 \uD55C \uBA85\uC774
      \uB9C8\uC9C0\uB9C9 \uCC29\uC9C0\uD310\uC5D0 \uB2FF\uC73C\uBA74 \uC131\uACF5\uD569\uB2C8\uB2E4."
    badge: 
  approach:
    title: "\uC678\uC904\uC5D0 \uC62C\uB77C\uAC00\uAE30"
    body: "\uC904 \uC704\uB85C \uAC78\uC5B4\uAC00\uBA74 \uC790\uB3D9\uC73C\uB85C

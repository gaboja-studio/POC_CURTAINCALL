    summary: "\uC678\uC904: \uCC29\uC6A9\uC790 2m \uC548\uC5D0\uC11C \uB0B4 \uC904\uB85C
      \uC774\uB3D9\uD574 \uCC29\uC9C0\uD558\uB294 \uD300\uC6D0\uC758 \uCC29\uC9C0
      \uADE0\uD615 \uC190\uC2E4 30% \uAC10\uC18C(\uC190\uC7A1\uC774\xB7\uBC84\uD300\uACFC
      \uACB9\uCE58\uBA74 \uD070 \uAC12 \uD558\uB098). \uC2E4\uC81C \uC644\uD654 \uC2DC
      1 \uC18C\uBAA8."
    shopDescription: "\uB0B4 \uC904\uB85C \uAC74\uB108\uC624\uB294 \uD300\uC6D0\uC744
      \uBD99\uC7A1\uC544 \uC90D\uB2C8\uB2E4. \uB0B4 \uACC1(2m \uC548)\uC5D0 \uCC29\uC9C0\uD558\uB294
      \uD300\uC6D0\uC758 \uD754\uB4E4\uB9BC\uC774 30% \uC904\uC5B4\uB4ED\uB2C8\uB2E4.\n\n\u2022
      \uC801\uC6A9: \uC678\uC904\uD0C0\uAE30\n\u2022 \uC0AC\uC6A9: \uC790\uB3D9(\uC2AC\uB86F)\n\u2022
      \uB0B4\uAD6C\uB3C4: 5\n\u2022 \uD300\uC6D0\uC744 \uBD99\uC7A1\uC744 \uB54C
      \uB0B4\uAD6C\uB3C4 \uC18C\uBAA8"
    shopTooltip: "\uAC74\uB108\uC624\uB294 \uD300\uC6D0\uC758 \uCC29\uC9C0 \uD754\uB4E4\uB9BC\uC744
